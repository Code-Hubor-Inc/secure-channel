# Replace with your real domain — Caddy will automatically obtain and renew a
# Let's Encrypt certificate for it (requires DNS pointed at this host and
# ports 80/443 reachable). For local testing without a domain, run
#   caddy: ... command: ["caddy", "reverse-proxy", "--from", ":8443", "--to", "vault:3000"]
# or replace the site address below with ":8443" to use Caddy's internal CA.
your-domain.example.com {
    reverse_proxy vault:3000
}
